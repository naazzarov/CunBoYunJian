# Load these into your shell or Docker Compose. The app does not parse .env itself.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
# Enable only if the configured provider supports strict JSON Schema output.
LLM_JSON_SCHEMA=0
LLM_API_KEY=
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=4
ASR_LANGUAGE=
# Named local speech toolchain (requires requirements-first-phase.txt and model weights).
# Keep whisper only as the documented backup until FunClip is verified.
ASR_BACKEND=whisper
FUNCLIP_PATH=
FUNCLIP_PYTHON=
FUNASR_MODEL=iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
FUNASR_MODEL_REVISION=v2.0.4
MODELSCOPE_CACHE=
MODELSCOPE_HOME=
HF_HOME=
# Optional silence removal and Chinese hard subtitles.
AUTO_EDITOR_BINARY=
EDITOR_PYTHON=
IMAGEMAGICK_BINARY=
SUBTITLE_FONT=
CLIPFORGE_DATA=data
MAX_UPLOAD_MB=2048
MAX_DURATION_SECONDS=14400
# Set a long random key for deployment. An access key is generated in data/ otherwise.
WORKSPACE_TOKEN=
# Only direct localhost connections bypass login. Disable this on shared servers.
LOCAL_TRUST=1
COOKIE_SECURE=0
# Optional OBS automation; configure scene, audio and recording directory in OBS.
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=
OBS_RECORDING_DIR=

# Group testing limits
MAX_PENDING_JOBS=6
MIN_FREE_DISK_MB=2048
TRANSCRIPT_WINDOW_CHARS=3000
LLM_TIMEOUT_SECONDS=480
